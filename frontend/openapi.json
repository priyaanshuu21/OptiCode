{
  "components": {
    "schemas": {
      "CompileOptions": {
        "properties": {
          "include_unreachable": {
            "default": true,
            "description": "Keep unreachable blocks in the CFG output.",
            "title": "Include Unreachable",
            "type": "boolean"
          },
          "max_iterations": {
            "default": 20,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Iterations",
            "type": "integer"
          },
          "passes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optimization passes to enable; null uses the default set.",
            "title": "Passes"
          }
        },
        "title": "CompileOptions",
        "type": "object"
      },
      "CompileRequest": {
        "properties": {
          "mode": {
            "default": "analyze",
            "enum": [
              "analyze",
              "optimize"
            ],
            "title": "Mode",
            "type": "string"
          },
          "options": {
            "$ref": "#/components/schemas/CompileOptions"
          },
          "source": {
            "description": "MiniC program text",
            "title": "Source",
            "type": "string"
          },
          "stdin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Program input for interpretation",
            "title": "Stdin"
          }
        },
        "required": [
          "source"
        ],
        "title": "CompileRequest",
        "type": "object"
      },
      "CompileResponse": {
        "properties": {
          "analysis": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Analysis"
          },
          "ast": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Ast"
          },
          "cfg": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Cfg"
          },
          "codegen": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Codegen"
          },
          "dataflow": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Dataflow"
          },
          "diagnostics": {
            "items": {
              "$ref": "#/components/schemas/DiagnosticModel"
            },
            "title": "Diagnostics",
            "type": "array"
          },
          "ir": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Ir"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "optimization": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Optimization"
          },
          "semantic": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Semantic"
          },
          "stages_run": {
            "items": {
              "type": "string"
            },
            "title": "Stages Run",
            "type": "array"
          },
          "stages_skipped": {
            "items": {
              "type": "string"
            },
            "title": "Stages Skipped",
            "type": "array"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings",
            "type": "object"
          },
          "tokens": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tokens"
          }
        },
        "required": [
          "success",
          "mode"
        ],
        "title": "CompileResponse",
        "type": "object"
      },
      "DiagnosticModel": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "related": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/RelatedModel"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Related"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info",
              "hint"
            ],
            "title": "Severity",
            "type": "string"
          },
          "span": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpanModel"
              },
              {
                "type": "null"
              }
            ]
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "severity",
          "code",
          "message",
          "stage"
        ],
        "title": "DiagnosticModel",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "stages": {
            "items": {
              "type": "string"
            },
            "title": "Stages",
            "type": "array"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "stages"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "RelatedModel": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "span": {
            "$ref": "#/components/schemas/SpanModel"
          }
        },
        "required": [
          "message",
          "span"
        ],
        "title": "RelatedModel",
        "type": "object"
      },
      "SpanModel": {
        "properties": {
          "end_col": {
            "description": "1-based end column (exclusive)",
            "minimum": 1.0,
            "title": "End Col",
            "type": "integer"
          },
          "end_line": {
            "description": "1-based end line (exclusive)",
            "minimum": 1.0,
            "title": "End Line",
            "type": "integer"
          },
          "start_col": {
            "description": "1-based start column",
            "minimum": 1.0,
            "title": "Start Col",
            "type": "integer"
          },
          "start_line": {
            "description": "1-based start line",
            "minimum": 1.0,
            "title": "Start Line",
            "type": "integer"
          }
        },
        "required": [
          "start_line",
          "start_col",
          "end_line",
          "end_col"
        ],
        "title": "SpanModel",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nOptiCode compiles MiniC \u2014 a small C-like language \u2014 through a real pipeline and returns\nevery stage's output in one response. All visualizations in the UI are rendered from\nthis data.\n",
    "title": "OptiCode",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/compile": {
      "post": {
        "operationId": "compile_endpoint_api_compile_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompileResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Compile Endpoint",
        "tags": [
          "compile"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    }
  }
}
